yarn-debug.log*
yarn-error.log*
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/testing/*
storage/framework/views/*
bootstrap/cache/*.php
public/build
docker-compose*.yml
.env
.env.*
!.env.example
tests
docs
