# Nom de l'application affiche dans Laravel et dans le frontend.
APP_NAME=SUZTECH

# Environnement d'execution cible.
APP_ENV=production

# Cle de chiffrement Laravel generee avec `php artisan key:generate --show`.
APP_KEY=

# Desactive l'affichage des erreurs en production.
APP_DEBUG=false

# URL publique canonique de l'application.
APP_URL=https://votre-app.onrender.com

# Locale principale de l'application.
APP_LOCALE=fr

# Locale de repli si une traduction manque.
APP_FALLBACK_LOCALE=fr

# Pilote de maintenance Laravel.
APP_MAINTENANCE_DRIVER=file

# Canal de logs principal, adapte aux conteneurs Render.
LOG_CHANNEL=stderr

# Stack de logs par defaut pour conserver une sortie compatible Render.
LOG_STACK=stderr

# Niveau minimum de verbosite des logs.
LOG_LEVEL=info

# Connexion base de donnees utilisee en production.
DB_CONNECTION=mysql

# Hote MySQL fourni par Render ou votre fournisseur.
DB_HOST=127.0.0.1

# Port MySQL de la base distante.
DB_PORT=3306

# Nom de la base de donnees applicative.
DB_DATABASE=suztech

# Utilisateur MySQL de production.
DB_USERNAME=suztech_user

# Mot de passe MySQL de production.
DB_PASSWORD=

# Store de cache applicatif Laravel.
CACHE_STORE=database

# Driver de session Laravel.
SESSION_DRIVER=database

# Duree de vie des sessions en minutes.
SESSION_LIFETIME=120

# Indique si les cookies de session doivent etre HTTPS-only.
SESSION_SECURE_COOKIE=true

# Domaine de partage des cookies de session.
SESSION_DOMAIN=null

# Systeme de fichiers par defaut pour les uploads publics.
FILESYSTEM_DISK=cloudinary

# URL Cloudinary utilisee pour stocker durablement les images produits.
CLOUDINARY_URL=cloudinary://CHANGE_ME:CHANGE_ME@CHANGE_ME

# Mode d'envoi des e-mails applicatifs.
MAIL_MAILER=smtp

# Schema SMTP eventuel (souvent tls ou null selon le provider).
MAIL_SCHEME=tls

# Hote SMTP pour les e-mails de verification.
MAIL_HOST=CHANGE_ME

# Port SMTP du provider.
MAIL_PORT=587

# Identifiant SMTP.
MAIL_USERNAME=CHANGE_ME

# Mot de passe ou token SMTP.
MAIL_PASSWORD=CHANGE_ME

# Adresse expediteur par defaut.
MAIL_FROM_ADDRESS=no-reply@suztech.bj

# Nom expediteur par defaut.
MAIL_FROM_NAME="${APP_NAME}"

# Driver de queue en production; sync si aucun worker dedie n'est configure.
QUEUE_CONNECTION=sync

# Connection broadcast utilisee si aucun broker temps reel n'est branche.
BROADCAST_CONNECTION=log

# Nom d'application compile dans le bundle frontend.
VITE_APP_NAME="${APP_NAME}"

# Endpoint Formspree compile dans le frontend pour le formulaire de contact.
VITE_FORMSPREE_URL=CHANGE_ME
