# PROD: Set the public application name used by Laravel and Vite.
APP_NAME=SUZTECH

# PROD: Render deployments should run with the production environment profile.
APP_ENV=production

# PROD: Generate this at first deploy with `php artisan key:generate --show`.
APP_KEY=

# PROD: Never expose debug output in public environments.
APP_DEBUG=false

# PROD: Set the canonical Render URL so signed URLs, redirects and HTTPS forcing stay coherent.
APP_URL=https://votre-app.onrender.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# PROD: Send logs to stderr for Render log collection.
LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# PROD: Configure the external MySQL database used by Render deployments.
DB_CONNECTION=mysql
DB_HOST=CHANGE_ME
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log

# PROD: Store public media in Cloudinary rather than on Render's ephemeral filesystem.
FILESYSTEM_DISK=cloudinary
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# PROD: Configure transactional email delivery instead of logging mails locally.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS=no-reply@suztech.bj
MAIL_FROM_NAME="${APP_NAME}"

# PROD: Cloudinary URL used by the Cloudinary Laravel package.
CLOUDINARY_URL=cloudinary://CHANGE_ME:CHANGE_ME@CHANGE_ME

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_FORMSPREE_URL=CHANGE_ME
